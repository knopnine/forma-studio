# Forma Studio — Environment Variables Example
# Duplicate this file to .env.local to enable Phase 1 anonymous cloud sync with Supabase.

# 1. Supabase Project URL (from Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key (safe for public clients)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
